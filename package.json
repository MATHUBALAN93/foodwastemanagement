    "react-router-dom": "^6.30.0",
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.1",
    "js-cookie": "^3.0.5",
    "@types/js-cookie": "^3.0.6",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.344.0",
    "react-hook-form": "^7.54.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
